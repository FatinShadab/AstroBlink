# ==============================================================
# AstroBlink Worker — Environment Variables
# For standalone (non-Docker) development.
# ==============================================================

# PostgreSQL connection (worker writes directly to DB)
DATABASE_URL=postgresql://astroblink:astroblink_dev@localhost:5432/astroblink

# Redis (job queue)
REDIS_URL=redis://localhost:6379/0

# MinIO / S3-compatible tile storage
TILE_S3_ENDPOINT=http://localhost:9000
TILE_S3_BUCKET=astroblink-tiles
TILE_S3_ACCESS_KEY=minioadmin
TILE_S3_SECRET_KEY=minioadmin

# SPHEREx S3 (anonymous access — no credentials needed)
SPHEREX_S3_BUCKET=nasa-irsa-spherex
SPHEREX_S3_REGION=us-east-1

# [VERIFY: OQ-1, OQ-4] IRSA Cutout Service
IRSA_CUTOUT_BASE_URL=https://irsa.ipac.caltech.edu/cgi-bin/Cutouts/nph-cutouts

# Temporary directory for downloaded FITS files (~500 MB peak)
FITS_SCRATCH_DIR=/tmp/astroblink
