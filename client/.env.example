# ==============================================================
# AstroBlink Client — Environment Variables
# For standalone (non-Docker) development.
# ==============================================================

# API base URL — browser-facing, inlined at build time.
# Changing this requires a rebuild (next build).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# API internal URL — used for SSR fetch calls from server components.
# Points to the API container on the Docker network.
API_INTERNAL_URL=http://api:8000

# Tile base URL — browser-facing, for <img src> on tile images.
# Points to MinIO in dev, S3 or CDN in prod.
TILE_BASE_URL=http://localhost:9000/astroblink-tiles

# Next.js listen port
PORT=3000
