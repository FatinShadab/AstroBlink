# ==============================================================
# AstroBlink .gitignore
# ==============================================================

# ── Environment & Secrets ──────────────────────────────────────
.env
.env.local
.env.*.local
!.env.example

# ── Python ─────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
*.egg-info/
dist/
build/
.eggs/
*.egg
.pytest_cache/
.ruff_cache/
coverage/
htmlcov/
.coverage
.coverage.*
*.cover

# ── Node.js ────────────────────────────────────────────────────
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo

# ── IDE ────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Docker ─────────────────────────────────────────────────────
# Don't ignore Dockerfiles or .dockerignore

# ── Data & Logs ────────────────────────────────────────────────
data/
*.fits
*.fits.gz
*.log
tmp/

# ── OS ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
