# ==============================================================
# AstroBlink — Root .env (LOCAL DEVELOPMENT ONLY)
# Used by docker compose. Never commit real secrets.
# Copy to .env and adjust as needed.
# ==============================================================

# ── PostgreSQL ─────────────────────────────────────────────────
POSTGRES_USER=astroblink
POSTGRES_PASSWORD=astroblink_dev
POSTGRES_DB=astroblink
POSTGRES_PORT=5432

# ── Redis ──────────────────────────────────────────────────────
REDIS_PORT=6379

# ── MinIO (S3-compatible tile storage) ─────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
TILE_S3_ENDPOINT=http://minio:9000
TILE_S3_BUCKET=astroblink-tiles
TILE_S3_ACCESS_KEY=minioadmin
TILE_S3_SECRET_KEY=minioadmin

# Browser-facing URL for tile images (host-reachable, not container-internal).
# The client embeds this in <img src> tags.
TILE_BASE_URL=http://localhost:9000/astroblink-tiles

# ── Derived connection strings (container-network hostnames) ───
DATABASE_URL=postgresql://astroblink:astroblink_dev@postgres:5432/astroblink
REDIS_URL=redis://redis:6379/0

# ── API ────────────────────────────────────────────────────────
API_PORT=8000
SECRET_KEY=dev-secret-change-in-production
CORS_ORIGINS=http://localhost:3000

# ── Client ─────────────────────────────────────────────────────
CLIENT_PORT=3000
# NEXT_PUBLIC_API_BASE_URL is a build-time arg for the client.
# It must be browser-reachable (not a container hostname).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# API_INTERNAL_URL is used for server-side rendering (SSR) calls
# from the client container to the API container.
API_INTERNAL_URL=http://api:8000

# ── Worker (SPHEREx data access) ───────────────────────────────
SPHEREX_S3_BUCKET=nasa-irsa-spherex
SPHEREX_S3_REGION=us-east-1
# [VERIFY: OQ-1, OQ-4] Exact IRSA Cutout Service endpoint
IRSA_CUTOUT_BASE_URL=https://irsa.ipac.caltech.edu/cgi-bin/Cutouts/nph-cutouts
FITS_SCRATCH_DIR=/tmp/astroblink
