# ==============================================================
# AstroBlink API — Environment Variables
# For standalone (non-Docker) development.
# ==============================================================

# PostgreSQL connection
DATABASE_URL=postgresql+asyncpg://astroblink:astroblink_dev@localhost:5432/astroblink

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO / S3-compatible tile storage
TILE_S3_ENDPOINT=http://localhost:9000
TILE_S3_BUCKET=astroblink-tiles
TILE_S3_ACCESS_KEY=minioadmin
TILE_S3_SECRET_KEY=minioadmin
TILE_BASE_URL=http://localhost:9000/astroblink-tiles

# JWT
SECRET_KEY=dev-secret-change-in-production

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# Uvicorn
PORT=8000

# Admin Auth Token (dev placeholder)
ADMIN_TOKEN=dev-admin-token-change-in-production

